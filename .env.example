# Copy to .env (git-ignored) and change the values. Used by compose.yaml and by the backend.
POSTGRES_DB=retail_erp
DB_ADMIN_USER=erp_owner
DB_ADMIN_PASSWORD=erp_owner_dev_password
DB_APP_USER=erp_app
DB_APP_PASSWORD=erp_app_dev_password
# Base64-encoded key of at least 32 bytes. Generate one with: openssl rand -base64 32
# If empty, the backend generates a random key at startup (tokens then stop working after a restart).
JWT_SECRET=
